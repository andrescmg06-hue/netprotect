APP_ENV=development
APP_VERSION=0.1.0-sprint1
POSTGRES_DB=netprotect
POSTGRES_USER=netprotect
POSTGRES_PASSWORD=change_me_dev_only
DATABASE_URL=postgresql+asyncpg://netprotect:change_me_dev_only@db:5432/netprotect
REDIS_PASSWORD=change_me_redis_dev_only
REDIS_URL=redis://:change_me_redis_dev_only@redis:6379/0
CORS_ORIGINS=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1,backend,10.0.2.2
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-client-id.apps.googleusercontent.com
JWT_SECRET=change_me_dev_only_jwt_secret
PAIRING_CODE_PEPPER=change_me_dev_only_pairing_pepper_at_least_32_bytes
# Fernet key (Sprint 13) — must be 32 url-safe base64-encoded bytes, not a free-form secret like
# the ones above. Generate your own with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LOCATION_ENCRYPTION_KEY=change_me_dev_only_run_python_fernet_generate_key
# Optional: leave empty to see the "sin mapa configurado" fallback. See docs/sprint-13.md — this
# key can't be generated by an agent, only by a human with a Google Cloud account (same as
# GOOGLE_WEB_CLIENT_ID above), restricted by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional (Sprint 18): leave both empty to see the wake-up nudge log "skipped, not configured"
# instead of failing. Needs a real Firebase project (console.firebase.google.com) and a
# service-account key file — same "only a human with a cloud account can generate this" situation
# as GOOGLE_WEB_CLIENT_ID/NEXT_PUBLIC_GOOGLE_MAPS_API_KEY above. See docs/sprint-18.md.
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_FILE=
LOG_LEVEL=INFO
