APP_ENV=production
APP_VERSION=0.1.0
POSTGRES_DB=netprotect
POSTGRES_USER=netprotect_app
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# Sprint 26: los ocho secretos que antes vivían aquí en texto plano (POSTGRES_PASSWORD,
# DATABASE_URL, REDIS_PASSWORD, REDIS_URL, JWT_SECRET, PAIRING_CODE_PEPPER,
# LOCATION_ENCRYPTION_KEY, GRAFANA_ADMIN_PASSWORD) ahora los lee compose.prod.yaml como archivos
# (bloque `secrets:`, montados en /run/secrets/<nombre>) — ver secrets/README.md para el nombre y
# contenido exacto de cada archivo. Nunca deben volver a vivir como variable de entorno en este
# archivo: `docker inspect`/`docker compose config` las mostrarían en texto plano.

# --- Dominios (Sprint 26) ---
# Los cinco valores de este bloque tienen que nombrar los MISMOS dos dominios — un `/code-review`
# antes de cerrar el sprint encontró una versión anterior de este archivo donde WEB_DOMAIN/
# API_DOMAIN ya usaban web.localhost/api.localhost pero CORS_ORIGINS/ALLOWED_HOSTS/
# NEXT_PUBLIC_API_BASE_URL seguían apuntando a placeholders *.example.com sin relación: quien
# siguiera "Verificación local" de docs/environments.md tal cual quedaría con TrustedHostMiddleware
# rechazando el Host que Caddy reenvía (400 Invalid host header) y el navegador bloqueando el
# fetch por CORS. Por defecto, los cinco usan `*.localhost` — funciona para la verificación local
# sin dominio propio (docs/sprint-26-evidence.md) tal cual, sin editar nada más. Para producción
# real (Paso 25, `docs/planning/plan-desarrollo.md`): cambiar los cinco a la vez a los dos
# subdominios reales, nunca uno solo.
WEB_DOMAIN=web.localhost
API_DOMAIN=api.localhost
CORS_ORIGINS=https://web.localhost
ALLOWED_HOSTS=api.localhost,backend
NEXT_PUBLIC_API_BASE_URL=https://api.localhost

GRAFANA_ADMIN_USER=admin

# Retención y periodicidad del backup de PostgreSQL (infra/backup/backup.sh).
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_SECONDS=86400

# Pendiente de un humano con una cuenta de Firebase (console.firebase.google.com, ver
# docs/sprint-18.md) — igual que WEB_DOMAIN/API_DOMAIN arriba. Dejar vacío sólo omite el aviso de
# despertar por FCM; los cambios de regla siguen funcionando por el canal WebSocket.
# FCM_SERVICE_ACCOUNT_FILE es una ruta a un archivo de credenciales montado en el contenedor del
# backend, nunca el contenido de la clave.
FCM_PROJECT_ID=REPLACE_WITH_YOUR_FIREBASE_PROJECT_ID
FCM_SERVICE_ACCOUNT_FILE=REPLACE_WITH_PATH_TO_MOUNTED_SERVICE_ACCOUNT_JSON

# Sprint 23 (remote screen viewing): comma-separated ICE servers for WebRTC. Not a secret —
# these are public infrastructure addresses. STUN alone is not enough on real mobile networks:
# add a TURN server of your own here (Paso 25, alongside the domain and certificates) if screen
# sharing has to work outside a shared LAN. See docs/sprint-23.md.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
LOG_LEVEL=INFO
