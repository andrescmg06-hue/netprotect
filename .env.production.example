APP_ENV=production
APP_VERSION=0.1.0
POSTGRES_DB=netprotect
POSTGRES_USER=netprotect_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql+asyncpg://netprotect_app:REPLACE_WITH_A_LONG_RANDOM_SECRET@db:5432/netprotect
REDIS_PASSWORD=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
REDIS_URL=redis://:REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET@redis:6379/0
CORS_ORIGINS=https://app.example.com
ALLOWED_HOSTS=api.example.com,backend
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
PAIRING_CODE_PEPPER=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET
# Fernet key (Sprint 13) — must be 32 url-safe base64-encoded bytes, generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Never reuse JWT_SECRET or PAIRING_CODE_PEPPER here — a leak of one secret must not decrypt
# stored locations too.
LOCATION_ENCRYPTION_KEY=REPLACE_WITH_A_FERNET_KEY_GENERATED_AS_ABOVE
# Pending a human with a Google Cloud account (see docs/sprint-13.md) — same situation as
# GOOGLE_WEB_CLIENT_ID above, restricted by HTTP referrer to this production domain. The web
# panel degrades to a text-only fallback if left empty.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=REPLACE_WITH_YOUR_PRODUCTION_GOOGLE_MAPS_API_KEY
LOG_LEVEL=INFO
