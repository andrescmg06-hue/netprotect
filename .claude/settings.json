{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "GIT_OPTIONAL_LOCKS": "0"
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./secrets/**)",
      "Read(./mobile/local.properties)",
      "Read(./mobile/app/google-services.json)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(docker compose -f compose.prod.yaml:*)",
      "Bash(docker compose down -v:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(make test)",
      "Bash(docker compose -f compose.test.yaml:*)",
      "Bash(ruff check:*)",
      "Bash(npm run lint)",
      "Bash(npm run build)"
    ]
  },
  "hooks": {
    "SessionStart": [
      { "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "timeout": 10,
          "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/session_context.py\"" }] }
    ],
    "PreToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "timeout": 5,
          "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_files.py\"" }] }
    ],
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "timeout": 20,
          "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/quick_lint.py\"" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "timeout": 120,
          "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop_checks.py\"" }] }
    ]
  }
}
