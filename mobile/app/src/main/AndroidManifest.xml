<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sprint 7 (inventario de apps): sin esto, Android 11+ oculta por defecto los paquetes
         instalados que no estén en un elemento <queries> — y no podemos enumerarlos de
         antemano porque no sabemos qué apps tendrá cada dispositivo supervisado. Publicar en
         Play exigiría el formulario de declaración de permisos; este proyecto se instala por
         sideload (Android Studio/adb), así que no aplica. Ver docs/android/capability-matrix.md. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Permiso especial: declararlo aquí no basta, el usuario debe concederlo aparte desde
         Ajustes (Settings.ACTION_USAGE_ACCESS_SETTINGS). Ver capability-matrix.md. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Sprint 8 (reglas de aplicaciones y bloqueo): sondear en segundo plano exige un
         foreground service, y todo foreground service exige mostrar una notificación — es un
         requisito del propio Android desde la API 26, no de la política de Play. Ver
         docs/android/capability-matrix.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- No es obligatorio para que el servicio arranque (verificado en la matriz), pero la
         notificación es deliberadamente visible, no algo que ocultar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Sprint 13 (ubicación): sólo aproximada a propósito — ver docs/android/capability-matrix.md.
         Deliberadamente sin ACCESS_FINE_LOCATION y sin ACCESS_BACKGROUND_LOCATION: un foreground
         service foregroundServiceType="location" ya cuenta como "en primer plano" para el sistema
         de permisos de ubicación mientras corre, así que no hace falta pedir el permiso de
         segundo plano (y con él, la política de "Prominent Disclosure" de Play). -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <application
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetProtect"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- launchMode singleTask + excludeFromRecents: se lanza repetidamente desde el
             servicio mientras la app bloqueada siga en primer plano; no debe apilarse ni
             aparecer como una tarea propia en Recientes. -->
        <activity
            android:name=".feature.supervised.BlockScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NetProtect" />

        <service
            android:name=".core.rules.RuleEnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Control parental: verifica qué app supervisada está en primer plano para aplicar reglas de bloqueo definidas por el tutor." />
        </service>

        <!-- Sprint 13: foregroundServiceType="location" es el tipo predefinido correcto aquí
             (a diferencia de RuleEnforcementService, este servicio sí encaja en un tipo
             estándar) — ver docs/android/capability-matrix.md. -->
        <service
            android:name=".core.location.LocationReportingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Sprint 20 (detección de manipulación): registro como Device Administrator, NO como
             device owner. El usuario lo concede desde la pantalla del sistema
             (ACTION_ADD_DEVICE_ADMIN) y puede quitarlo cuando quiera; mientras esté activo,
             Android exige desactivarlo antes de desinstalar la app, y esa desactivación dispara
             onDisableRequested() — la única forma oficial de detectar un intento de
             desinstalación sin ser device owner. No aplica ninguna política (device_admin.xml
             tiene <uses-policies> vacío). android:permission="BIND_DEVICE_ADMIN" es obligatorio:
             restringe la invocación del receiver al propio sistema. exported="true" porque quien
             lo invoca es el sistema, no esta app. -->
        <receiver
            android:name=".core.tamper.NetProtectDeviceAdminReceiver"
            android:exported="true"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
