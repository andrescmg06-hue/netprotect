<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Sprint 63: a normal permission (no dialog). NetworkState uses it to tell "no Internet"
         apart from "the service does not answer" when a request fails. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Sprint 7 (inventario de apps): sin esto, Android 11+ oculta por defecto los paquetes
         instalados que no estén en un elemento <queries> — y no podemos enumerarlos de
         antemano porque no sabemos qué apps tendrá cada dispositivo supervisado. Lo usa solo el lado
         supervisado: sincronizar el inventario de apps, mostrar nombre e ícono de la app en la
         pantalla de bloqueo y resolver los paquetes protegidos (ProtectedPackages). Publicar en
         Play exigiría el formulario de declaración de permisos; este proyecto se instala por
         sideload (Android Studio/adb), así que no aplica. Ver docs/android/capability-matrix.md. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Permiso especial: declararlo aquí no basta, el usuario debe concederlo aparte desde
         Ajustes (Settings.ACTION_USAGE_ACCESS_SETTINGS). Ver capability-matrix.md. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Sprint 8 (reglas de aplicaciones y bloqueo): sondear en segundo plano exige un
         foreground service, y todo foreground service exige mostrar una notificación — es un
         requisito del propio Android desde la API 26, no de la política de Play. Ver
         docs/android/capability-matrix.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- No es obligatorio para que el servicio arranque (verificado en la matriz), pero la
         notificación es deliberadamente visible, no algo que ocultar. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Verificado en ejecución real (17/09/2026, emulador API 36): un foreground service sin
         actividad visible ya NO puede abrir una Activity con startActivity() directo — Android
         lo bloquea como "Background Activity Launch" (ActivityTaskManager: "Background activity
         launch blocked!"). El mecanismo que Android sí exime de esta restricción es exactamente
         el que usan las llamadas entrantes y alarmas: una notificación con
         Notification.Builder#setFullScreenIntent(). Ver BlockScreenActivity/
         RuleEnforcementService y docs/android/capability-matrix.md. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />

    <!-- The mechanism that actually works while the device is unlocked and in active use — see
         BlockOverlayController. Special-access permission, granted separately in Settings, same
         shape as PACKAGE_USAGE_STATS. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Ubicación precisa desde el 2026-10-14, por decisión explícita del dueño del proyecto: en
         un teléfono real la aproximada situaba el dispositivo a kilómetros (sustituye la decisión
         de solo aproximada del Sprint 13; ver docs/android/capability-matrix.md). FINE y COARSE se
         declaran y piden juntos porque Android 12+ exige COARSE junto a FINE; si la persona elige
         «aproximada» en el diálogo, solo se concede COARSE. Sigue sin ACCESS_BACKGROUND_LOCATION:
         un foreground service foregroundServiceType="location" ya cuenta como "en primer plano"
         para el sistema de permisos de ubicación mientras corre (y exige COARSE o FINE, no el de
         segundo plano), así que no hace falta pedirlo ni asumir la política de "Prominent
         Disclosure" de Play. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Sprint 23 (supervisión remota): la captura de pantalla se autoriza con el diálogo del
         sistema (MediaProjectionManager.createScreenCaptureIntent()), no con este permiso — éste
         sólo habilita el foreground service de tipo mediaProjection que Android exige mientras
         dure la captura. El consentimiento es POR SESIÓN: verificado en la documentación oficial,
         un MediaProjection sirve para una sola llamada a createVirtualDisplay() y reutilizar el
         Intent lanza SecurityException. Ver docs/android/capability-matrix.md. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Sprint 73: la protección se restablece sola al encender el teléfono (BootReceiver), sin
         esperar a que el supervisado abra la app. Permiso normal, sin diálogo. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetProtect"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- launchMode singleTask + excludeFromRecents: se lanza repetidamente desde el
             servicio mientras la app bloqueada siga en primer plano; no debe apilarse ni
             aparecer como una tarea propia en Recientes. -->
        <activity
            android:name=".feature.supervised.BlockScreenActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.NetProtect" />

        <service
            android:name=".core.rules.RuleEnforcementService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Control parental: verifica qué app supervisada está en primer plano para aplicar reglas de bloqueo definidas por el tutor." />
        </service>

        <!-- Sprint 13: foregroundServiceType="location" es el tipo predefinido correcto aquí
             (a diferencia de RuleEnforcementService, este servicio sí encaja en un tipo
             estándar) — ver docs/android/capability-matrix.md. -->
        <service
            android:name=".core.location.LocationReportingService"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Sprint 23: tipo predefinido mediaProjection, obligatorio para poder capturar la
             pantalla. La notificación persistente que Android exige aquí no es un extra: mientras
             se comparte, el supervisado debe poder verlo y cortarlo. -->
        <service
            android:name=".core.screenshare.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <!-- Sprint 73: reinicia la protección tras reiniciar el teléfono (BOOT_COMPLETED) o
             actualizar la app (MY_PACKAGE_REPLACED). exported="false": ambos los envía el propio
             sistema, que puede entregar a un receptor no exportado (la comprobación de exportado no
             aplica al uid del sistema), y así ninguna otra app puede dispararlo. Ver
             core/boot/BootReceiver.kt y docs/android/capability-matrix.md (Sprint 73). -->
        <receiver
            android:name=".core.boot.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Sprint 20 (detección de manipulación): registro como Device Administrator, NO como
             device owner. El usuario lo concede desde la pantalla del sistema
             (ACTION_ADD_DEVICE_ADMIN) y puede quitarlo cuando quiera; mientras esté activo,
             Android exige desactivarlo antes de desinstalar la app, y esa desactivación dispara
             onDisableRequested() — la única forma oficial de detectar un intento de
             desinstalación sin ser device owner. No aplica ninguna política (device_admin.xml
             tiene <uses-policies> vacío). android:permission="BIND_DEVICE_ADMIN" es obligatorio:
             restringe la invocación del receiver al propio sistema. exported="true" porque quien
             lo invoca es el sistema, no esta app. -->
        <receiver
            android:name=".core.tamper.NetProtectDeviceAdminReceiver"
            android:exported="true"
            android:description="@string/device_admin_description"
            android:label="@string/device_admin_label"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
